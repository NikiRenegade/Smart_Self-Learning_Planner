<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:SmartLearningPlanner.MobileApp.ViewModels"
             x:Class="SmartLearningPlanner.MobileApp.Views.Pages.RoadmapDetailsPage"
             Title="Информация о карте"
             BackgroundColor="White">

    <VerticalStackLayout Padding="20" Spacing="16">

        <Label Text="{Binding Title}"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="Black" />

        <Label Text="{Binding Description}"
               FontSize="16"
               TextColor="#555"
               LineBreakMode="WordWrap" />

        <Label Text="{Binding NodeCount, StringFormat='Узлов в карте: {0}'}"
               FontSize="14"
               TextColor="#888" />

        <Button Text="Начать изучение"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding StartLearningCommand}" />

    </VerticalStackLayout>
</ContentPage>