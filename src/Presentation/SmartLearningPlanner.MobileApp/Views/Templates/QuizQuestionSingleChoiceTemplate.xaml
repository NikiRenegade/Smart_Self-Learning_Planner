<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
										xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
										x:Class="SmartLearningPlanner.MobileApp.Views.Templates.QuizQuestionSingleChoiceTemplate">
	<DataTemplate x:Key="QuizQuestionSingleChoiceTemplate">
		<Frame BorderColor="Gray"
					 Padding="10"
					 Margin="0,10">
			<VerticalStackLayout Spacing="5">
				<Label Text="{Binding QuestionType.Name}"
							 FontAttributes="Bold"/>
				<Entry Placeholder="Текст вопроса"
							 Text="{Binding QuestionText}"/>

				<CollectionView ItemsSource="{Binding QuizQuestionAnswerOptions}">
					<CollectionView.ItemTemplate>
						<DataTemplate>
							<HorizontalStackLayout Spacing="10">
								<CheckBox IsChecked="{Binding IsCorrect}"/>
								<Entry Placeholder="Вариант ответа"
											 Text="{Binding AnswerText}"/>
								<Button Text="❌"
												BackgroundColor="Transparent"
												Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveOptionCommand}"
												CommandParameter="{Binding .}"/>
							</HorizontalStackLayout>
						</DataTemplate>
					</CollectionView.ItemTemplate>
				</CollectionView>
				<Button Text="Добавить вариант"
								Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AddOptionCommand}"
								CommandParameter="{Binding .}"/>

				<Button Text="Удалить вопрос"
								Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveQuestionCommand}"
								CommandParameter="{Binding .}"/>
			</VerticalStackLayout>
		</Frame>
	</DataTemplate>
</ResourceDictionary>