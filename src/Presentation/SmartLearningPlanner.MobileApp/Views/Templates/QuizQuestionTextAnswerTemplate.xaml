<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
										xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
										x:Class="SmartLearningPlanner.MobileApp.Views.Templates.QuizQuestionTextAnswerTemplate">
	<DataTemplate x:Key="QuizQuestionTextAnswerTemplate">
		<Frame BorderColor="Gray"
					 Padding="10"
					 Margin="0,10">
			<VerticalStackLayout Spacing="5">
				<Label Text="{Binding QuestionType.Name}"
							 FontAttributes="Bold"/>
				<Entry Placeholder="Текст вопроса"
							 Text="{Binding QuestionText}"/>
				<Entry Placeholder="Ваш ответ"
							 Text="{Binding UserTextAnswer}"/>
			</VerticalStackLayout>
		</Frame>
	</DataTemplate>
</ResourceDictionary>